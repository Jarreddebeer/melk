{
  "name": "document-light-with-gradients",
  "tokens": {
    "surface": "#fafafa",
    "surface-raised": "#ffffff",
    "surface-sunken": "#f1f5f9",
    "ink-primary": "#334155",
    "ink-secondary": "#64748b",
    "border-strong": "#334155",
    "border-subtle": "#cbd5e1",
    "trace-default": "#94a3b8",
    "trace-emphasis": "#2563eb",
    "trace-muted": "#cbd5e1",
    "status-error": "#dc2626",
    "status-warn": "#d97706",
    "status-ok": "#16a34a",
    "status-info": "#2563eb",
    "label-halo": "#fafafa",
    "accents": ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2"]
  },
  "typography": {
    "face": "Inter, -apple-system, Segoe UI, Roboto, sans-serif",
    "face-mono": "JetBrains Mono, Consolas, Monaco, monospace",
    "size": { "body": 10, "edge": 9, "frame": 9, "title": 20, "subtitle": 13, "caption": 9 },
    "weight": { "label": 500, "heading": 600, "title": 700, "subtitle": 500 }
  },
  "strokes": {
    "outline": 1.0,
    "trace": 1.0,
    "emphasis": 2.5,
    "frame": 0.75,
    "underground-opacity": 0.45,
    "underground-width": 0.75,
    "manhole-radius": 2,
    "dash": { "frame": [4, 3], "back-edge": [5, 3] },
    "arrow": { "scale": 4.5, "head-shape": "filled-triangle" },
    "icon-style": "outlined"
  },
  "tags": {
    "future": {
      "border": "status-warn",
      "border-width": 1.5,
      "dash": [4, 3],
      "icon-color": "status-warn",
      "legend": "Future state"
    },
    "critical": {
      "border": "status-error",
      "border-width": 1.5,
      "icon-color": "status-error",
      "fill": "linear 135deg, #fee2e2, #fff5f5",
      "legend": "Critical path"
    },
    "deprecated": {
      "trace": "ink-secondary",
      "dash": [3, 3],
      "opacity": 0.6,
      "icon-color": "ink-secondary",
      "legend": "Deprecated route"
    },
    "external": {
      "border": "status-info",
      "border-width": 1.5,
      "icon-color": "status-info",
      "fill": "linear 180deg, #dbeafe, #eff6ff",
      "legend": "External system"
    },
    "showcase": {
      "border": "linear 90deg, #0d9488, #06b6d4",
      "icon-color": "linear 135deg, #e11d48, #f59e0b",
      "fill": "linear 135deg, #ccfbf1, #f0fdfa",
      "legend": "Tri-colour showcase"
    }
  }
}
