{
  "name": "uml-light",
  "tokens": {
    "surface": "#ffffff",
    "surface-raised": "#ffffff",
    "surface-sunken": "#f8fafc",
    "ink-primary": "#1e293b",
    "ink-secondary": "#64748b",
    "border-strong": "#334155",
    "border-subtle": "#cbd5e1",
    "trace-default": "#475569",
    "trace-emphasis": "#7c3aed",
    "trace-muted": "#cbd5e1",
    "status-error": "#dc2626",
    "status-warn": "#d97706",
    "status-ok": "#16a34a",
    "status-info": "#2563eb",
    "label-halo": "#ffffff",
    "accents": ["#7c3aed", "#2563eb", "#0891b2", "#16a34a", "#d97706", "#dc2626"]
  },
  "typography": {
    "face": "Inter, -apple-system, Segoe UI, Roboto, sans-serif",
    "face-mono": "JetBrains Mono, Consolas, Monaco, monospace",
    "size": { "body": 10, "edge": 9, "frame": 9, "title": 20, "subtitle": 13, "caption": 9 },
    "weight": { "label": 500, "heading": 600, "title": 700, "subtitle": 500 }
  },
  "strokes": {
    "outline": 1.0,
    "trace": 1.0,
    "emphasis": 2.5,
    "frame": 0.75,
    "underground-opacity": 0.45,
    "underground-width": 0.75,
    "manhole-radius": 2,
    "dash": { "frame": [4, 3], "back-edge": [5, 3] },
    "arrow": { "scale": 4.5, "head-shape": "filled-triangle" }
  },
  "tags": {
    "interface": {
      "fill": "linear 180deg, #ede9fe, #f5f3ff",
      "border": "#7c3aed",
      "border-width": 1.5,
      "legend": "«interface» / abstract"
    },
    "value": {
      "fill": "linear 180deg, #ecfeff, #f0fdfa",
      "border": "#0891b2",
      "border-width": 1.5,
      "legend": "Value object"
    },
    "pci": {
      "border": "#dc2626",
      "border-width": 1.5,
      "fill": "linear 135deg, #fee2e2, #fff5f5",
      "legend": "PCI-sensitive"
    }
  }
}
