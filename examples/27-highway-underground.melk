layout: lr
crossings: 10

# Variant of 16-highway-bundle.melk with the highway marked
# `render: underground` (DESIGN-PHASE4.md §11.11). Each via-trace
# through `hwy` dips below the surface: the interior stretch is
# drawn at half opacity and thinner, with small manhole circles at
# the entry (west) and exit (east) perimeter where the trace dips
# down and surfaces again.

src_a { size: 7x5 }
dst_x { size: 7x5 }
dst_y { size: 7x5 }
src_b { size: 7x5 }
dst_z { size: 7x5 }
src_c { size: 7x5 }
hwy { shape: highway, render: underground }

src_a -> dst_x { via: hwy }
src_a -> dst_y { via: hwy }
src_b -> dst_y { via: hwy }
src_b -> dst_z { via: hwy }
src_c -> dst_x { via: hwy }
src_c -> dst_z { via: hwy }
