layout: lr
crossings: 20

# Service with six output channels, each routed to one or two
# external consumers. Tests slot demand on the fan-out's east comb
# and the convergence of multiple channels onto each cylinder.

ingest { size: 7x5 }
metrics { size: 7x5 }
events { size: 7x5 }
alerts { size: 7x5 }
traces { size: 7x5 }
snapshots { size: 9x5 }
router     { shape: rect,     size: 9x9, label: "router" }
source     { shape: rect,                 label: "source", size: 7x5 }
prometheus { shape: cylinder, size: 11x5, label: "prometheus" }
kafka      { shape: cylinder, size: 7x5,  label: "kafka" }
s3         { shape: cylinder, size: 5x5,  label: "s3" }
pager      { shape: rect,     size: 9x5,  label: "pagerduty" }
jaeger     { shape: cylinder, size: 9x5,  label: "jaeger" }


source  -> ingest
ingest  -> router { avoid: channels }
fan-out channels: router -> [metrics, events, audit, alerts, traces, snapshots]

metrics   -> prometheus
traces    -> prometheus
events    -> kafka
audit     -> kafka
audit     -> s3
snapshots -> s3
alerts    -> pager
traces    -> jaeger

nodeset Bus: ingest, router, metrics, events, audit, alerts, traces, snapshots
