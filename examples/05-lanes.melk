layout: lr
crossings: 6

# Three horizontal lanes, each a separate pipeline. Lanes are pure
# annotation: a `pipeline` parks its members on one row, and each
# `nodeset` draws a dashed rectangle around its members at render time.
# The placer leaves a MEMBER_GAP between disconnected pipelines so
# lane rectangles don't visually overlap (Phase 4).
#
# Cross-lane edges are written as bare forwards. They route through
# the empty cells between lanes — the channel router walks the grid
# and bends in the gap, so the dashed nodeset rectangles read as
# coherent lanes while signals still cross between them.

ingest     { size: 7x5 }
transform  { shape: rect,     size: 9x5, label: "ETL" }
ods        { shape: cylinder, size: 9x5, label: "ODS" }

auth       { shape: diamond, size: 7x5 }
controller { shape: rect,    size: 9x5 }

api        { shape: rect,   size: 9x5 }
client     { shape: circle }

pipeline data:    ingest -> transform -> ods
pipeline control: auth -> controller
pipeline egress:  api -> client

# Cross-lane signals. `transform -> auth` invokes the control plane
# from data; `controller -> api` feeds an authorisation result onto
# the egress lane.
transform  -> auth { exit: S, entry: N }
controller -> api { exit: S, entry: N }

nodeset data-plane: ingest, transform, ods
nodeset control:    auth, controller
nodeset egress:     api, client
