# Edge plane: client traffic terminates here. CDN → WAF → gateway.
#
# Public surface (parent-addressable as `edge.<name>`):
#   - ingress: where client requests arrive
#   - egress:  forwarded to the next plane

layout: lr

ingress { size: 7x5 }
egress { size: 7x5 }
pipeline edge_chain: ingress -> cdn -> waf -> gateway -> egress

cdn     { shape: rect, label: "CDN", size: 7x5 }
waf     { shape: rect, label: "WAF", size: 7x5 }
gateway { shape: rect, label: "API gateway", size: 11x5 }
