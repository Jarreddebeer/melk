layout: lr
crossings: 10

# Highway as a mid-graph bundle: external producers feed services
# through an inlet highway. Each service then emits to a small
# downstream tail of normalisers and a common store.
#
# The pipeline tails are written as plain edges (not `pipeline`
# declarations) because the highway-via anchor and pipeline anchor
# both try to fix the position of svc_a / svc_b. Plain edges
# follow the highway's placement without competing for it.

inlet { shape: highway }
db    { shape: cylinder, label: "store" }

ext_1 -> svc_a { via: inlet }
ext_1 -> svc_b { via: inlet }
ext_2 -> svc_a { via: inlet }
ext_2 -> svc_b { via: inlet }
ext_3 -> svc_a { via: inlet }
ext_3 -> svc_b { via: inlet }

svc_a  -> norm_a
norm_a -> db
svc_b  -> norm_b
norm_b -> db

nodeset services: svc_a, svc_b
