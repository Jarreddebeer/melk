# Showcase copy of examples/38-twelve-factor-web.melk for the README gallery.
# Diagonal gradient on the PostgreSQL node.
layout: lr
title: "Twelve-Factor web app"
subtitle: "Stateless web tier, async workers, attached backing services"
caption: "Source: examples/38-twelve-factor-web.melk"
theme: "./showcase.json"

client { size: 7x5 }
lb       { shape: rect,      label: "load balancer", size: 13x5 }
queue    { shape: rect,      label: "queue\n(broker)", size: 9x7 }
db       { shape: cylinder,  label: "PostgreSQL\n(primary)", size: 13x9, tags: [gray-grad-vertical] }
cache    { shape: cylinder,  label: "Redis\n(cache)", size: 9x7 }

web1     { shape: rect, label: "web.1", size: 7x5 }
web2     { shape: rect, label: "web.2", size: 7x5 }
web3     { shape: rect, label: "web.3", size: 7x5 }

worker1  { shape: rect, label: "worker.1", size: 9x5 }
worker2  { shape: rect, label: "worker.2", size: 9x5 }

client -> lb
fan-out web-tier: lb -> [web1, web2, web3]
bus enqueue:      [web1, web2, web3] -> queue

fan-out workers:    queue -> [worker1, worker2]
bus db-writes:      [worker1, worker2] -> db
branch cache-warm:right: worker2 -> cache
