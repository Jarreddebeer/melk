{
  "name": "showcase",
  "tokens": {
    "surface": "#fafafa",
    "surface-raised": "#ffffff",
    "surface-sunken": "#f1f5f9",
    "ink-primary": "#334155",
    "ink-secondary": "#64748b",
    "border-strong": "#334155",
    "border-subtle": "#cbd5e1",
    "trace-default": "#94a3b8",
    "trace-emphasis": "#2563eb",
    "trace-muted": "#cbd5e1",
    "status-error": "#dc2626",
    "status-warn": "#d97706",
    "status-ok": "#16a34a",
    "status-info": "#2563eb",
    "label-halo": "#fafafa",
    "accents": ["#2563eb", "#dc2626", "#16a34a", "#d97706", "#7c3aed", "#0891b2"]
  },
  "typography": {
    "face": "Inter, -apple-system, Segoe UI, Roboto, sans-serif",
    "face-mono": "JetBrains Mono, Consolas, Monaco, monospace",
    "size": { "body": 10, "edge": 9, "frame": 9, "title": 20, "subtitle": 13, "caption": 9 },
    "weight": { "label": 500, "heading": 600, "title": 700, "subtitle": 500 }
  },
  "strokes": {
    "outline": 1.0,
    "trace": 1.0,
    "emphasis": 2.5,
    "frame": 0.75,
    "underground-opacity": 0.45,
    "underground-width": 0.75,
    "manhole-radius": 2,
    "dash": { "frame": [4, 3], "back-edge": [5, 3] },
    "arrow": { "scale": 4.5, "head-shape": "filled-triangle" },
    "icon-style": "outlined"
  },
  "tags": {
    "gray-grad": {
      "fill": "linear 135deg, #f8fafc, #cbd5e1",
      "legend": "Gradient fill"
    },
    "gray-grad-vertical": {
      "fill": "linear 180deg, #f8fafc, #cbd5e1",
      "legend": "Vertical gradient fill"
    },
    "blue-border": {
      "border": "status-info",
      "border-width": 1.5,
      "legend": "Blue border"
    },
    "blue-trace": {
      "trace": "#93c5fd",
      "legend": "Subdued blue trace"
    },
    "subdued-blue-border": {
      "border": "#93c5fd",
      "border-width": 1.5,
      "legend": "Subdued blue border"
    },
    "icon-blue": {
      "icon-color": "status-info",
      "legend": "Blue icon"
    },
    "icon-orange": {
      "icon-color": "status-warn",
      "legend": "Orange icon"
    }
  }
}
